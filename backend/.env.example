NODE_ENV=development
APP_NAME=Travel Planning Platform API
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/travel_planning

# Frontend origins
CORS_ORIGINS=http://localhost:3001

# Authentication — replace with strong random secrets
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_random_secret_at_least_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookies
# Defaults to true when NODE_ENV=production, false otherwise. Set false to demo over plain http://localhost
# in production mode (a startup warning is logged); set true behind HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Stripe test credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3001/payment/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3001/payment/cancel

# FX Rates API
FXRATES_API_KEY=
FXRATES_BASE_URL=https://api.fxratesapi.com
FXRATES_CACHE_TTL_MS=900000
FXRATES_STALE_TTL_MS=86400000

# Local development media storage (never expose this as an API response)
MEDIA_STORAGE_PATH=uploads/media

# Development-only seed configuration (set locally; never commit passwords)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MODERATOR_EMAIL=
SEED_MODERATOR_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Optional: folder with the reference CSV files for `npm run seed:reference` (default: data/reference)
# REFERENCE_DATA_DIR=data/reference

# Minutes a Pending Payment hotel/flight reservation holds its rooms/seats (HTL-18, FLT-22). Default 10.
# BOOKING_HOLD_MINUTES=10
