# Copy this file to .env and fill it in. Never commit .env. Every value below is a placeholder.

# --- Application ---
NODE_ENV=development
APP_NAME=Travel Planning Platform API
PORT=3000

# --- MongoDB (required) ---
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/travel_planning

# --- Frontend origins allowed by CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3001

# --- Authentication (required): two different random secrets of at least 32 characters ---
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_random_secret_at_least_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Cookies ---
# Optional. Defaults to true when NODE_ENV=production and false otherwise. Set true behind HTTPS.
COOKIE_SECURE=false
# Optional cookie domain; leave empty for the current host.
COOKIE_DOMAIN=

# --- Stripe test mode: set both or neither ---
# Secret key (sk_test_...) from the Stripe dashboard.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# --- One currency for every price and payment. ISO 4217, default USD ---
PLATFORM_CURRENCY=USD

# --- Exchange rates (itinerary budget conversion) ---
FXRATES_API_KEY=
FXRATES_BASE_URL=https://api.fxratesapi.com
# Fresh-cache window and stale-fallback window in milliseconds (stale must be >= cache).
FXRATES_CACHE_TTL_MS=900000
FXRATES_STALE_TTL_MS=86400000

# --- Local media storage folder (never exposed as an API response) ---
MEDIA_STORAGE_PATH=uploads/media

# --- Optional: folder with the reference CSV files for `npm run seed:reference` ---
# REFERENCE_DATA_DIR=data/reference

# --- Demo seed (`npm run seed`) ---
# Optional: password of the demo users. Default DemoPass123 (at least 8 characters, a letter and a digit).
# SEED_PASSWORD=
# Optional: same as passing --yes.
# SEED_CONFIRM=yes

# --- Account seed (`npm run seed:accounts`): required only for that script ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_MODERATOR_EMAIL=
SEED_MODERATOR_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
